# Global configuration
NODE_ENV="development"
PORT="3000"

# Web origins allowed
CORS_ORIGIN="https://my-orbit.mael-bertocchi.fr"

# Database configuration
DATABASE_URL="postgresql://username:password@localhost:5432/my-orbit"

# Single-user identity
IDENTITY_ORIGIN="https://my-orbit.mael-bertocchi.fr"
IDENTITY_OWNER_NAME="Maël"
IDENTITY_ENROLLMENT_TOKEN=""

# JWT configuration
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# Watchlist catalog
WATCHLIST_TMDB_TOKEN=""
GEOAPIFY_API_KEY=""
